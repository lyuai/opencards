# Any provider implementing the OpenAI Responses API can be used.
# Keep credentials server-side. Never expose them through NEXT_PUBLIC_* variables.
AI_PROVIDER=openrouter:openai/gpt-5.6-luna
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-5.6-luna
AI_PROTOCOL=responses

# OPENAI_API_KEY, OPENAI_MODEL, and OPENAI_BASE_URL are accepted as aliases.
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
