{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencards.lyu.ai/schemas/replay/v1.json",
  "title": "OpenCards Replay v1",
  "type": "object",
  "required": ["schemaVersion", "game", "ruleset", "players", "events", "provenance"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "game": { "type": "string", "enum": ["guandan", "kards"] },
    "ruleset": { "type": "string", "minLength": 1 },
    "players": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "required": ["seat", "displayName"],
        "properties": { "seat": { "type": "string" }, "displayName": { "type": "string" }, "team": { "type": "string" } },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object", "required": ["sequence", "type", "actor", "payload", "confidence"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 0 },
          "timestampMs": { "type": "integer", "minimum": 0 },
          "type": { "type": "string" },
          "actor": { "type": "string" },
          "payload": { "type": "object" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object", "required": ["sourceType", "sourceId", "ingestedAt"],
      "properties": {
        "sourceType": { "type": "string", "enum": ["native", "manual", "video"] },
        "sourceId": { "type": "string" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "ingestedAt": { "type": "string", "format": "date-time" },
        "rights": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
